# ============================================================
# JAH ENGINE - Variables de entorno (plantilla .env.example)
# ============================================================
# Copia este archivo a `.env` y ajusta los valores.
#
# REGLA DE VITE: solo las variables que empiezan por `VITE_` se
# exponen al codigo del navegador (import.meta.env). Nunca pongas
# secretos aqui: quedan visibles en el bundle de produccion;
# las claves reales se gestionan en el servidor/microservicio.

# ============================================================
# 1) FUENTE DE DATOS DE TELEMETRIA (Modulo 1 - HomeLab Monitor)
# ============================================================
# Activa el modo de datos simulados (true) o llamadas reales a la
# API (false). Con 'true' se carga el mock local con una latencia
# artificial de 400ms, sin necesidad de backend levantado.
# La decision se toma en src/features/network/services/telemetryService.ts
VITE_USE_MOCK_DATA=true

# URL base para la API de telemetria de HomeLab Monitor (microservicio Astro).
# Solo se usa cuando VITE_USE_MOCK_DATA=false.
VITE_API_URL=https://homelab-monitor.acevedojavier.dev/api/v1/metrics/telemetry

# Clave de autenticacion para el backend. Se envia en la cabecera
# 'X-API-Key'. En produccion NUNCA debe ir en un .env versionado ni
# en el bundle; usala solo para desarrollo local.
VITE_API_KEY=tu_token_secreto_aqui

# ============================================================
# 2) HOMELAB MONITOR - Conexion en tiempo real (WebSocket) y app externa
# ============================================================
# Endpoint WebSocket del microservicio HomeLab Monitor (Astro).
# Si no se define, el widget de HomeLab usa su simulador local.
VITE_HOMELAB_WS_URL=ws://localhost:4321/ws

# URL publica de la app completa de HomeLab Monitor. Si se define,
# el widget muestra el boton "App HomeLab" (enlace externo).
VITE_HOMELAB_APP_URL=http://localhost:4321

# ============================================================
# 3) STORAGE & REMOTE BACKUPS (Modulo 3) y BENCHMARK (Modulo 2)
# ============================================================
# La decision MOCK vs API se lee en
# src/features/backups/services/backupService.ts y en
# src/features/benchmark/services/benchmarkService.ts, y COMPARTE la
# misma flag del Modulo 1 (VITE_USE_MOCK_DATA): con 'true', la capa
# de servicio responde desde sus mocks locales (mockBackupData.ts /
# mockBenchmarkEngine.ts) con una latencia artificial (~300ms / ~2.5s
# de simulacion); con 'false', usa fetch contra VITE_API_BASE_URL. Asi
# la UI nunca sabe de donde vienen los datos.
VITE_USE_MOCK_DATA=true

# URL base de la API REST de backups y de benchmark (microservicio).
# Solo se consulta cuando VITE_USE_MOCK_DATA=false.
# La capa de servicio monta endpoints como /backups/targets o
# /benchmark/run sobre este prefijo.
VITE_API_BASE_URL=http://localhost:3000/api