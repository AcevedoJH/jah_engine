# ============================================================
# JAH ENGINE - Variables de entorno (desarrollo local)
# ============================================================
# Copia local para `npm run dev`. Los valores de abajo son de
# desarrollo y NO son secretos. Copia/ajusta desde .env.example.

# ============================================================
# 1) FUENTE DE DATOS (Modulos 1 y 3)
# ============================================================
# true  -> datos simulados (mock) con latencia artificial.
# false -> llamadas reales a la API (requiere backend levantado).
VITE_USE_MOCK_DATA=true

# URL base de la API de telemetria (Modulo 1 - HomeLab Monitor).
VITE_API_URL=https://homelab-monitor.acevedojavier.dev/api/v1/metrics/telemetry

# Clave de autenticacion para desarrollo local (no versionar en prod).
VITE_API_KEY=tu_token_secreto_aqui

# ============================================================
# 2) HOMELAB MONITOR - WebSocket y app externa
# ============================================================
VITE_HOMELAB_WS_URL=ws://localhost:4321/ws
VITE_HOMELAB_APP_URL=https://homelab-monitor.acevedojavier.dev

# ============================================================
# 3) STORAGE & REMOTE BACKUPS (Modulo 3)
# ============================================================
# URL base de la API REST de backups. Solo se usa con
# VITE_USE_MOCK_DATA=false.
VITE_API_BASE_URL=http://localhost:3000/api